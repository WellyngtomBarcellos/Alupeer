APP_NAME=Lugator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
IMG_BB_KEY=
MAP_BOX_TOKEN=

# Socket.IO (chat realtime)
# SOCKET_SERVER_URL empty = same origin (recommended behind FrankenPHP)
SOCKET_SERVER_URL=
SOCKET_SERVER_INTERNAL_URL=http://socket:3001
SOCKET_SERVER_SECRET=
SOCKET_ALLOWED_ORIGIN=http://localhost:8000
# Run migrations on container start (true/false)
RUN_MIGRATIONS=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# PRODUCTION STRIPE
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt-BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=alupeer
DB_USERNAME=alupeer
DB_PASSWORD=
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
